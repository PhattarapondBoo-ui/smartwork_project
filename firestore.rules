rules_version = '2';

// Worklist Management — Firestore security rules.
// The UI hides buttons, but THESE rules are what actually enforce roles.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isActive() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().status == 'active';
    }
    function isEmployer() { return isActive() && me().role == 'employer'; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------- meta
    // meta/setup exists once the first employer has been created.
    match /meta/setup {
      allow read: if true; // login page checks it before anyone signs in
      allow create: if signedIn()
        && getAfter(userPath(request.auth.uid)).data.role == 'employer';
      allow update, delete: if false;
    }

    // meta/counters holds the running number used for task codes (T-0001).
    match /meta/counters {
      allow read, write: if isEmployer();
    }

    // --------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isEmployer();

      allow create: if isEmployer()
        // Bootstrap: the very first account may make itself employer,
        // only in the same batch that creates meta/setup.
        || (signedIn() && request.auth.uid == userId
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup)
            && request.resource.data.role == 'employer'
            && request.resource.data.status == 'active');

      allow update: if isEmployer()
        // Everyone may edit their own basic info, but not role/status/username.
        || (isActive() && request.auth.uid == userId
            && changedKeys().hasOnly(['name', 'phone', 'updated_at']));

      allow delete: if false; // users are deactivated, never deleted

      match /password_history/{entryId} {
        allow read: if (signedIn() && request.auth.uid == userId) || isEmployer();
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.user_id == userId;
        allow update, delete: if false;
      }
    }

    // --------------------------------------------------------------- tasks
    match /tasks/{taskId} {
      function t() { return resource.data; }
      function n() { return request.resource.data; }

      // Employee claims an open task. Works for "all users" tasks nobody holds
      // yet, and for tasks assigned specifically to them.
      function isClaim() {
        return t().status == 'open'
          && (t().assigned_user == null || t().assigned_user == request.auth.uid)
          && n().status == 'claimed'
          && n().assigned_user == request.auth.uid
          && changedKeys().hasOnly(['status', 'assigned_user', 'assigned_user_name', 'claimed_at', 'updated_at']);
      }

      // Assignee moves their own task forward.
      function isProgress() {
        return t().assigned_user == request.auth.uid
          && n().assigned_user == request.auth.uid
          && (
            (t().status == 'claimed' && n().status == 'in_progress')
            || (t().status == 'rejected' && n().status == 'in_progress')
            || (t().status in ['claimed', 'in_progress', 'rejected'] && n().status == 'pending_review')
          )
          && changedKeys().hasOnly(['status', 'updated_at', 'last_submitted_at']);
      }

      allow read: if isEmployer()
        || (isActive() && (resource.data.assigned_type == 'all'
                           || resource.data.assigned_user == request.auth.uid));

      allow create: if isEmployer()
        && request.resource.data.status == 'open'
        && request.resource.data.is_archived == false;

      allow update: if isEmployer()
        || (isActive() && t().is_archived == false && (isClaim() || isProgress()));

      allow delete: if false; // "delete" in the UI = archive (is_archived = true)

      // ------------------------------------------------- submissions
      match /submissions/{submissionId} {
        function task() { return get(/databases/$(database)/documents/tasks/$(taskId)).data; }

        allow read: if isEmployer()
          || (isActive() && task().assigned_user == request.auth.uid);

        allow create: if isActive()
          && task().assigned_user == request.auth.uid
          && task().is_archived == false
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.task_id == taskId
          && request.resource.data.review_status == 'pending'
          && request.resource.data.image_urls.size() <= 10;

        allow update: if isEmployer()
          && request.resource.data.review_status in ['approved', 'rejected']
          && changedKeys().hasOnly(['review_status', 'review_note', 'reviewed_by', 'reviewed_by_name', 'reviewed_at']);

        allow delete: if false; // keep full submission history
      }
    }
  }
}
